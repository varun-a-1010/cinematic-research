# Google Cloud project with the Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Model supported by Grounding with Parallel Search.
GEMINI_MODEL=gemini-3.8-flash

# Fastest hackathon setup: create a key at https://platform.parallel.ai.
PARALLEL_API_KEY=

# Alternative to PARALLEL_API_KEY: subscribe to Parallel Web Search in Google
# Cloud Marketplace and set this to true.
PARALLEL_USE_MARKETPLACE=false
